#!/bin/sh
set -eu

# Ubuntu 24.04 ships an older live-build that reads local hooks from
# config/hooks/*.chroot rather than config/hooks/normal/*.hook.chroot.
# Debian Trixie installs the BIOS boot files under /usr/lib, while this
# live-build version expects them at /root/isolinux inside the chroot.
mkdir -p /root/isolinux
test -e /usr/lib/ISOLINUX/isolinux.bin
test -e /usr/lib/syslinux/modules/bios/vesamenu.c32
ln -sf /usr/lib/ISOLINUX/isolinux.bin /root/isolinux/isolinux.bin
ln -sf /usr/lib/syslinux/modules/bios/vesamenu.c32 /root/isolinux/vesamenu.c32

# Generate and select only the US English UTF-8 system locale.
printf '%s\n' 'en_US.UTF-8 UTF-8' > /etc/locale.gen
locale-gen
printf '%s\n' 'LANG=en_US.UTF-8' 'LANGUAGE=en_US:en' > /etc/default/locale
printf '%s\n' 'XKBLAYOUT="us"' > /etc/default/keyboard
